APP_ENV=dev
PORT=3000

COOKIE_SECRET=change-me-to-a-random-string

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# Links used in customer emails (storefront pages) and the admin dashboard URL
VERIFY_EMAIL_URL=http://localhost:8080/verify
PASSWORD_RESET_URL=http://localhost:8080/password-reset
CHANGE_EMAIL_URL=http://localhost:8080/verify-email-address-change
ADMIN_URL=http://localhost:3000/dashboard

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wisko_vendure
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public

# RabbitMQ (for ERP sync)
RABBITMQ_URL=amqp://user:password@localhost:5672

# Staff sign-in and Store permissions through ZITADEL (wisko-auth: wisko-setup.json > vendureEnv)
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_PROJECT_ID=
ZITADEL_PLATFORM_ORG_ID=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_SERVICE_TOKEN=
ZITADEL_SESSION_HOURS=12
VENDURE_URL=http://localhost:3000
WISKO_VENDURE_PASSWORD_LOGIN=off

# Abandoned carts (cart.abandoned): minutes a cart must sit unchanged, and the storefront cart page
CART_ABANDONED_AFTER_MINUTES=30
STOREFRONT_CART_URL=http://localhost:8080/cart

# Birthday promotions (the percent is set per store: Channel > Birthday discount (%)): the timezone of the store day
BIRTHDAY_TIMEZONE=Asia/Kathmandu

# Assets — S3 (leave empty for local filesystem in dev)
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_FORCE_PATH_STYLE=false
# ASSET_URL_PREFIX=https://my-domain.com/assets/
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=
SMTP_FROM_EMAIL='"example" <noreply@example.com>'
